# ================================================================
# VIDEO MODULE - Trợ lý 35
# Sao chép file này thành .env và điền giá trị thật.
# KHÔNG commit file .env vào git.
# ================================================================

# ---------------------------------------------------------------
# Kế thừa từ Trợ lý 35 (đã có sẵn trong backend GAS)
# ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------
# Mới cho video module
# ---------------------------------------------------------------
# Nhóm duyệt nội bộ (3-5 cán bộ phòng) — tạo mới, chưa có
TELEGRAM_REVIEW_CHAT_ID=-100xxxxxxxxxx

# Nhóm chính đã có của Trợ lý 35
TELEGRAM_MAIN_CHAT_ID=-100xxxxxxxxxx

# Danh sách user_id Telegram được phép bấm nút Duyệt (phân cách bằng dấu phẩy)
TELEGRAM_APPROVER_IDS=123456789,987654321

# ---------------------------------------------------------------
# LLM để sinh scenes.json
# Mặc định: claude-sonnet-4-6 (đủ cho structured JSON output)
# Nâng lên claude-opus-4-7 nếu thấy Sonnet output kém chất lượng
# ---------------------------------------------------------------
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
# Temperature cho structured JSON output. 0 = ổn định, ít drift. Mặc định 0.
LLM_TEMPERATURE=0

# Hoặc dùng OpenAI thay thế:
# OPENAI_API_KEY=
# LLM_MODEL=gpt-4o

# ---------------------------------------------------------------
# TTS — thứ tự ưu tiên theo §0.3 trong PLAN:
#   edge (miễn phí, không quota) → fpt → viettel → openai
# Giai đoạn đầu dùng edge-tts, chỉ đổi sang fpt nếu cần giọng
# chính luận đặc thù hơn.
# ---------------------------------------------------------------
TTS_PROVIDER=google
# Giới hạn giây cho mỗi provider; vượt sẽ bỏ qua provider đó và chuyển fallback.
TTS_PROVIDER_TIMEOUT=120

# Google Cloud TTS (khuyến nghị — WaveNet vi-VN, 1M ký tự/tháng miễn phí)
# Tạo Service Account tại console.cloud.google.com → IAM → Service Accounts
# Đặt file JSON vào video_module/credentials/ (đã gitignore)
GOOGLE_APPLICATION_CREDENTIALS=credentials/google-tts.json
GOOGLE_TTS_VOICE=vi-VN-Wavenet-D
# Giọng Bắc: vi-VN-Wavenet-A (nữ), vi-VN-Wavenet-B (nam), vi-VN-Wavenet-C (nữ), vi-VN-Wavenet-D (nam)
GOOGLE_TTS_SPEAKING_RATE=0.95
GOOGLE_TTS_PITCH=0.0

# edge-tts (fallback miễn phí — tự động dùng khi Google lỗi)
EDGE_TTS_VOICE=vi-VN-NamMinhNeural

# FPT.AI (fallback thứ 2 — cần whitelist IP)
FPT_AI_TTS_API_KEY=
FPT_AI_TTS_VOICE=thuminh
FPT_AI_TTS_SPEED=0

# Viettel AI (backup thứ 2)
VIETTEL_TTS_API_KEY=
VIETTEL_TTS_VOICE=hn-quynhanh

# ---------------------------------------------------------------
# Nhạc nền + bản ngắn (video quick wins)
# ---------------------------------------------------------------
# Đường dẫn file nhạc nền (mp3/m4a/wav/ogg/aac). Bỏ trống = tự quét assets/music/.
# Nhạc PHẢI là loại bản quyền tự do (royalty-free / CC0). Sẽ tự lặp + ducking dưới giọng đọc.
BACKGROUND_MUSIC_PATH=
# Âm lượng nhạc nền (0.0–1.0). Khuyến nghị 0.12–0.22 để không lấn giọng đọc.
BACKGROUND_MUSIC_VOLUME=0.18

# Bản ngắn cho TikTok/Reels/Shorts: chọn scene đưa vào + thời lượng tối đa (giây).
# Luôn giữ intro (hook) + cta; nếu quá dài sẽ tự bỏ bớt scene ở giữa.
SHORT_SCENES=intro,summary,news1,cta
SHORT_MAX_SECONDS=35

# ---------------------------------------------------------------
# Tùy chọn
# ---------------------------------------------------------------
LOG_LEVEL=INFO
WEBSITE_URL=https://www.troly35.info.vn/

# Endpoint GAS để fetch bản tin mới nhất (Giai đoạn 5, bước 00_fetch_input.py)
# GAS_DEPLOYMENT_URL: URL Web App dạng https://script.google.com/macros/s/.../exec
# GAS_API_TOKEN: giá trị của Script Property API_ACCESS_TOKEN trong GAS
GAS_DEPLOYMENT_URL=
GAS_API_TOKEN=
